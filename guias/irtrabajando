Paso 8: Manifiesto Consolidado Final ``.tekton/pipeline.yaml``
==============================================================

Este manifiesto integra todas las tareas validadas:

* Uso de workspace efímero (``emptyDir: {}``).
* Clonado con ``git-clone`` y compilación con ``buildah``.
* Despliegue automático y validación de rollout en el namespace ``my-app-dev``.

.. code-block:: yaml

   apiVersion: tekton.dev/v1
   kind: PipelineRun
   metadata:
     name: my-app-simple-full-pipeline
     annotations:
       pipelinesascode.tekton.dev/on-event: "[push]"
       pipelinesascode.tekton.dev/on-target-branch: "[develop]"
       pipelinesascode.tekton.dev/max-keep-runs: "3"
       pipelinesascode.tekton.dev/task: "[git-clone, buildah]"
   spec:
     params:
       - name: repo_url
         value: "{{ repo_url }}"
       - name: revision
         value: "{{ revision }}"
     workspaces:
       - name: shared-workspace
         emptyDir: {}
       - name: basic-auth
         secret:
           secretName: "{{ git_auth_secret }}"
     pipelineSpec:
       params:
         - name: repo_url
         - name: revision
       workspaces:
         - name: shared-workspace
         - name: basic-auth
       tasks:
         - name: git-clone
           taskRef:
             name: git-clone
           params:
             - name: url
               value: "$(params.repo_url)"
             - name: revision
               value: "$(params.revision)"
             - name: sslVerify
               value: "false"
             - name: subdirectory
               value: ""
           workspaces:
             - name: output
               workspace: shared-workspace
             - name: basic-auth
               workspace: basic-auth

         - name: build-image
           taskRef:
             name: buildah
           runAfter:
             - git-clone
           params:
             - name: IMAGE
               value: "image-registry.openshift-image-registry.svc:5000/my-app-dev/my-app-simple:$(params.revision)"
             - name: STORAGE_DRIVER
               value: "vfs"
             - name: TLSVERIFY
               value: "false"
             - name: CONTEXT
               value: "."
             - name: DOCKERFILE
               value: "Dockerfile"
           workspaces:
             - name: source
               workspace: shared-workspace

         - name: deploy-app
           runAfter:
             - build-image
           workspaces:
             - name: source
               workspace: shared-workspace
           taskSpec:
             workspaces:
               - name: source
             steps:
               - name: apply-and-verify
                 image: quay.io/openshift/origin-cli:latest
                 script: |
                   #!/usr/bin/env bash
                   set -e
                   cd $(workspaces.source.path)
                   oc apply -f kubernetes/deployment.yaml -n my-app-dev
                   oc set image deployment/my-app-simple my-app-simple=image-registry.openshift-image-registry.svc:5000/my-app-dev/my-app-simple:$(params.revision) -n my-app-dev
                   oc rollout status deployment/my-app-simple -n my-app-dev --timeout=300s
